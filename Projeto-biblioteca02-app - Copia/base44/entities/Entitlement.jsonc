{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "ativo",
        "revogado"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "ativo"
    },
    "granted_at": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "access_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}