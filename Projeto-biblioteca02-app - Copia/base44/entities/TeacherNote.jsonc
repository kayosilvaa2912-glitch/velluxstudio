{
  "name": "TeacherNote",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Professor dono da anota\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo opcional da anota\u00e7\u00e3o"
    },
    "content": {
      "type": "string",
      "description": "Texto livre da anota\u00e7\u00e3o, sem limite de caracteres"
    }
  },
  "required": [
    "user_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}