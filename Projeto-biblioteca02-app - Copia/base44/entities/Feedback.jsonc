{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "elogio",
        "sugestao",
        "problema",
        "outro"
      ],
      "enumColors": [
        "green",
        "blue",
        "red",
        "gray"
      ],
      "default": "sugestao"
    },
    "message": {
      "type": "string",
      "description": "Mensagem escrita pelo professor"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "lido",
        "arquivado"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "novo"
    },
    "email_status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviado",
        "falhou"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "user_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}