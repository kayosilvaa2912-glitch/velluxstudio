{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "default": "zuptos"
    },
    "external_transaction_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "external_product_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "refused",
        "refunded",
        "chargeback",
        "canceled"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "purple",
        "red",
        "gray"
      ],
      "default": "pending"
    },
    "amount": {
      "type": "number"
    },
    "purchased_at": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "payment_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}